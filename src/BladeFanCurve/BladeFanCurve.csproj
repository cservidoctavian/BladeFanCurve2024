<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BladeFanCurve</RootNamespace>
    <AssemblyName>BladeFanCurve</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.3.1</Version>
    <Product>Blade Fan Curve</Product>
    <Company>BladeFanCurve</Company>
    <Description>Temperature-driven fan control for Razer Blade laptops</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- InvariantGlobalization MUST stay false. WPF's font cache constructs
         CultureInfo("en") while measuring text, which throws CultureNotFoundException
         in globalization-invariant mode and takes the window down on first render.
         There is a regression test for this in tests/ProtocolTests. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds these as implicit usings, which collides with WPF's
         Point/Color/Brush/Application. Files that need WinForms import it explicitly. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
